@namespace char
@;              0..32: built-in
@define EXCLAM          @{chr  33}
@define QUOT            @{chr  34}
@define NUM             @{chr  35}
@define DOLLAR          @{chr  36}
@define PERCNT          @{chr  37}
@define AMP             @{chr  38}
@define APOS            @{chr  39}
@define LPAR            @{chr  40}
@define RPAR            @{chr  41}
@define AST             @{chr  42}
@define PLUS            @{chr  43}
@define COMMA           @{chr  44}
@define DASH            @{chr  45}
@define PERIOD          @{chr  46}
@define SOL             @{chr  47}
@;              48..57: 0-9
@define COLON           @{chr  58}
@define SEMI            @{chr  59}
@define LT              @{chr  60}
@define EQUALS          @{chr  61}
@define GT              @{chr  62}
@define QUEST           @{chr  63}
@define COMMAT          @{chr  64}
@;              65..90: A-Z
@define LBRACK          @{chr  91}
@define BSOL            @{chr  92}
@define RBRACK          @{chr  93}
@define HAT             @{chr  94}
@define UNDERBAR        @{chr  95}
@define GRAVE           @{chr  96}
@;              97..122: a-z
@define LBRACE          @{chr 123}
@define VERT            @{chr 124}
@define RBRACE          @{chr 125}
@define TILDE           @{chr 126}
@;      DEL     127  built-in
